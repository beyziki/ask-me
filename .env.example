# Ask Me? — örnek yapılandırma.
# Bu dosyayı `.env` olarak kopyalayıp ihtiyacına göre düzenle.
# Tüm ayarların tam listesi: backend/app/core/config.py

# --- Foundry Local ---
# Kullanılacak model alias'ı. `foundry model list` ile mevcut olanları görebilirsin.
# Varsayılan, DÜŞÜNMEYEN (instruct) bir model: hızlı ve boş-cevap arızası yok.
FOUNDRY_MODEL_ALIAS=ministral-3-3b-instruct-2512

# Modelin akıl yürütme (thinking) modu var mı? Boş bırakılırsa alias'tan
# otomatik çıkarılır (qwen3 / deepseek-r1 / qwq -> true). Elle zorlamak için:
# MODEL_THINKING=true

# Cevap uzunluğu üst sınırı (token).
# ANSWER_MAX_TOKENS=800

# Model ve embedding'i backend açılışında arka planda ısıt (ilk soruyu hızlandırır).
# WARMUP_ON_STARTUP=true

# --- RAG ---
# Embedding modelinin cihazı. Varsayılan "cpu": GPU'yu Foundry Local'in dil
# modeline bırakıyor. İkisi aynı karta sığmadığında "CudaMallocArray - out of
# memory" alınıyor. Kartında yer varsa ve dosya yükleme hızlansın istiyorsan:
# EMBEDDING_DEVICE=cuda
# Chunk boyutu KELİME cinsinden. Değiştirirsen mevcut dosyalar eski boyutta
# kalır; etkili olması için o dosyaları silip yeniden yükle.
# CHUNK_SIZE=220
# CHUNK_OVERLAP=40

# Her aramadan alınan aday sayısı ve LLM'e gerçekten gönderilen parça sayısı.
# TOP_K_SEMANTIC=8
# TOP_K_BM25=8
# MAX_CONTEXT_CHUNKS=5
# MAX_CONTEXT_CHARS=6000

# En iyi semantic benzerlik bunun altındaysa "dosyalarda ilgili bilgi yok"
# sayılır ve model genel bilgisiyle, bunu belirterek cevap verir.
# MIN_RELEVANCE_SCORE=0.30
